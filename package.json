{
  "name": "soc-tools",
  "version": "1.8.10",
  "private": true,
  "description": "Client-side tools for security operations center analysts.",
  "license": "MIT",
  "author": "Bastiaan Scheffer",
  "repository": "https://github.com/Bananenbaas/soc-tools",
  "type": "module",
  "overrides": {
    "nanoid": "^5.1.6"
  },
  "scripts": {
    "dev": "node scripts/generate-theme-assets.mjs && vite",
    "build": "node scripts/generate-theme-assets.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude '**/tests/e2e/**'",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "vue": "^3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
